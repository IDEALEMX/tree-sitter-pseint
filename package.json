{
  "name": "tree-sitter-pseint",
  "version": "0.1.0",
  "description": "A simple tree-sitter grammar for pseint",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idealemx/tree-sitter-pseint.git.git"
  },
  "funding": "",
  "license": "GNU General Public License v3.0",
  "author": {
    "name": "IDEALEMX",
    "email": "idemx@proton.me",
    "url": "https://ideale.nekoweb.org/"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "pseint"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
